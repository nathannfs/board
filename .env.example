# Matches docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/board

# Where the app answers. Better Auth builds its callback URLs from this.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth app. The callback is $BETTER_AUTH_URL/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Read in the browser, so it has to be written out in full at build time.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional. Turns on the shared guest account in the header, for a deployment
# with no GitHub OAuth application. Seed it with `pnpm db:seed:guest`.
DEMO_MODE=false
DEMO_PASSWORD=
